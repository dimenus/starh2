+test "runtime: spawnInto prefer_local is valid under every scheduling" {
+    if (builtin.single_threaded) return error.SkipZigTest;
+
+    const H = struct {
+        fn currentId() ExecutorId {
+            return getCurrentExecutor().id;
+        }
+
+        fn parent(rt: *Runtime) !void {
+            const id = currentId();
+            var handle = try rt.spawnInto(.prefer_local, currentId, .{});
+            const child_id = handle.join();
+            // Without migration the hint is a promise; with it, the child may
+            // have been stolen before it ran, so only success is checked.
+            if (!migrates) try std.testing.expectEqual(id, child_id);
+
+            var group: Group = .init;
+            defer group.cancel();
+            for (0..8) |_| try group.spawnInto(.prefer_local, currentId, .{});
+            try group.wait();
+            try std.testing.expect(!group.hasFailed());
+        }
+
+        fn foreign(rt: *Runtime, result: *?anyerror, out: *?JoinHandle(ExecutorId)) void {
+            out.* = rt.spawnInto(.prefer_local, currentId, .{}) catch |err| {
+                result.* = err;
+                return;
+            };
+        }
+    };
+
+    const runtime = try Runtime.init(std.testing.allocator, .{ .executors = .exact(2) });
+    defer runtime.deinit();
+
+    var handle = try runtime.spawnInto(.auto, H.parent, .{runtime});
+    try handle.join();
+
+    // From a thread that is not an executor, the hint falls back to `.auto`
+    // instead of failing the spawn.
+    var result: ?anyerror = null;
+    var foreign_handle: ?JoinHandle(ExecutorId) = null;
+    const thread = try std.Thread.spawn(.{}, H.foreign, .{ runtime, &result, &foreign_handle });
+    thread.join();
+    try std.testing.expectEqual(null, result);
+    _ = foreign_handle.?.join();
+}
