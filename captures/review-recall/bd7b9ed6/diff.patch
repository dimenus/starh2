+    /// Whether `close` has been called. A select driver that receives
+    /// `error.Closed` from its queue arm can use this to tell a real close
+    /// (stop draining) from a spurious win (re-poll): `error.Closed` with
+    /// `isClosed() == false` can only be the spurious case, whoever closes
+    /// the queue.
+    pub fn isClosed(self: *CompletionQueue) bool {
+        self.mutex.lock();
