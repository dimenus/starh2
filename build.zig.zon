.{
    .name = .starh2,
    .version = "0.1.0",
    .fingerprint = 0x813a04b419058cf5,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // LOCAL EXPERIMENT pin: zio 0299e57 plus tools/zio-prefer-local/prefer-local.diff
        // (a `.prefer_local` placement). tools/zio-prefer-local/pack.sh writes the
        // tarball at this path and checks the hash. Not for master.
        .zio = .{
            .url = "/tmp/starh2-zio-prefer-local.tar.gz",
            .hash = "zio-0.18.0-xHbVVLtSKgBTh3L_kMvlu9A5NJrowXV6QKjjpQ8m_aUc",
        },
        // Lazy: only `starh2_datastar` and the examples use the SDK, so a
        // consumer of the core HTTP/2 module never fetches or compiles it.
        .datastar = .{
            .url = "git+https://github.com/zigster64/datastar-sdk.zig#0c1f91f3d82ecd1dad3c53b9450db12623fc3408",
            .hash = "datastar_sdk_zig-0.1.0-IRNEdq1bAABGAHWmZAq3JuU9B7N0G-XxrvvIka1X_sHN",
            .lazy = true,
        },
        .brotli = .{
            .url = "https://github.com/google/brotli/archive/refs/tags/v1.1.0.tar.gz",
            .hash = "N-V-__8AAF_gIQDX2wVzXI-r96NyCgKuDj9W_Gab-TU7Qzoi",
        },
        .boring = .{
            .url = "https://github.com/hendriknielaender/boring/archive/refs/tags/v0.1.1.tar.gz",
            .hash = "boring-0.1.0-K6muvtBGCQAHvnOGuLmCcLZn-WgZkddupoEFKwSKpL7U",
        },
    },
    // brotli pin: google/brotli v1.1.0 release archive (raw C sources; no build.zig)
    // tag v1.1.0 / https://github.com/google/brotli/archive/refs/tags/v1.1.0.tar.gz
    // consumed via addCSourceFiles on c/common + c/enc (c/dec only on test artifacts)
    // boring pin: hendriknielaender/boring v0.1.1
    // BoringSSL source: -Dboringssl-source-path, else vendor/boringssl, else
    // ../../oss/http2-zig-hendrik/boringssl (revision recorded in tools/lock.json)
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "tests",
        "fuzz",
        "tools",
        "AGENTS.md",
        "zb",
        "LICENSE",
    },
}
