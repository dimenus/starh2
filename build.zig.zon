.{
    .name = .starh2,
    .version = "0.1.0",
    .fingerprint = 0x813a04b419058cf5,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // dimenus/zio sim/dst-m3: lalinsky/zio main cd0befa plus three parts
        // upstream does not carry:
        // - the io_uring send -EAGAIN bridge (wait for writability, then
        //   resend). Upstream will not merge it (PR #863). It stays until the
        //   kernel fix for -EAGAIN on an io_uring send ships on the machines
        //   we run, or upstream zio adds its own workaround.
        // - the DST simulator and the select/CompletionQueue invariant
        //   checks, which panic in every build.
        // - two ThreadSanitizer race fixes (a Debug copy of a tagged union
        //   read across threads; the work-stealing ring's slots).
        .zio = .{
            .url = "git+https://github.com/dimenus/zio#3d50bb64f829bd1d24d27fae3986d5fad20002eb",
            .hash = "zio-0.19.0-xHbVVKIbMADD3Z24pfz1Jf08CFqiVAWhiLpbDEgA7ole",
        },
        // Lazy: only `starh2_datastar` and the examples use the SDK, so a
        // consumer of the core HTTP/2 module never fetches or compiles it.
        .datastar = .{
            .url = "git+https://github.com/zigster64/datastar-sdk.zig#0c1f91f3d82ecd1dad3c53b9450db12623fc3408",
            .hash = "datastar_sdk_zig-0.1.0-IRNEdq1bAABGAHWmZAq3JuU9B7N0G-XxrvvIka1X_sHN",
            .lazy = true,
        },
        .brotli = .{
            .url = "https://github.com/google/brotli/archive/refs/tags/v1.1.1.tar.gz",
            .hash = "N-V-__8AADrmIQC_5_Eoi00Qet2ZIEpsrIaYyx5OyBfsocRM",
        },
        // ianic/tls.zig main bd22bcb (2026-10-03, after "update to zig 0.17").
        // Pure Zig TLS: src/edge/tls.zig drives its non-blocking API. Its
        // "trailing partial record" decrypt test is the guard for lalinsky's
        // ef6780e fix, which upstream carries in a different form.
        .tls = .{
            .url = "git+https://github.com/ianic/tls.zig#bd22bcb73f423389441a1de80bf031ef1b623cce",
            .hash = "tls-0.1.0-ER2e0l6qBgDEYo6RBkVZw5UrxOqtI6-OqLwyFJvEr3RK",
        },
    },
    // brotli pin: google/brotli v1.1.1 release archive (raw C sources; no build.zig)
    // tag v1.1.1 / https://github.com/google/brotli/archive/refs/tags/v1.1.1.tar.gz
    // consumed via addCSourceFiles on c/common + c/enc (c/dec only on test artifacts)
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "tests",
        "fuzz",
        "tools",
        "AGENTS.md",
        "zb",
        "LICENSE",
    },
}
